{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@storage/*": ["storage/*"],
      "@utils/*": ["utils/*"],
      "@/*": ["./*"]
    },
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "lib": ["dom", "es2020"],
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
