{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.8.0",
  "description": "__MSG_extension_description__",
  "icons": {
    "16": "icons/play-plus_16x.png",
    "48": "icons/play-plus_48x.png",
    "128": "icons/play-plus_128x.png"
  },
  "permissions": ["storage", "tabs", "webRequest", "sidePanel", "unlimitedStorage"],
  "host_permissions": ["https://*.coupangplay.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_action_default_title__"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.coupangplay.com/*"],
      "js": ["content.js"]
    }
  ],
  "default_locale": "ko"
}
