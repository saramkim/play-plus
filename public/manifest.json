{
  "manifest_version": 3,
  "name": "Play Plus - 쿠팡플레이 기능 맞춤 설정",
  "version": "1.0.0",
  "description": "쿠팡플레이의 기능들을 개인 맞춤 설정할 수 있습니다.",
  "icons": {
    "16": "icons/play-plus_16x.png",
    "48": "icons/play-plus_48x.png",
    "128": "icons/play-plus_128x.png"
  },
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": ["https://*.coupangplay.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.coupangplay.com/*"],
      "js": ["content.js"]
    }
  ]
}
