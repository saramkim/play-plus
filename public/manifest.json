{
  "manifest_version": 3,
  "name": "Play Plus - 쿠팡플레이 기능 확장",
  "version": "1.1.0",
  "description": "쿠팡플레이의 기능을 확장하고, 사용자가 원하는 대로 커스텀할 수 있습니다.",
  "icons": {
    "16": "icons/play-plus_16x.png",
    "48": "icons/play-plus_48x.png",
    "128": "icons/play-plus_128x.png"
  },
  "permissions": ["storage", "tabs", "webRequest", "sidePanel"],
  "host_permissions": ["https://*.coupangplay.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Play Plus 열기"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.coupangplay.com/*"],
      "js": ["content.js"]
    }
  ]
}
